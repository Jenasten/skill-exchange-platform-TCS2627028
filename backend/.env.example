# Rename this file to .env and fill in your own values

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/skillexchange

# Secret key used to sign JWT tokens (use a long random string)
JWT_SECRET=replace_this_with_a_long_random_secret

# Port the backend server runs on
PORT=5000

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Email (Gmail example - use an "App Password", not your real password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_app_password
